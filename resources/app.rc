#include "resource.h"

1 RT_MANIFEST "app.manifest"
IDI_APPICON ICON "app_icon.ico"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Silent Vibrance\0"
      VALUE "FileDescription", "Silent Vibrance\0"
      VALUE "FileVersion", "2.0.0\0"
      VALUE "InternalName", "SilentVibrance\0"
      VALUE "OriginalFilename", "SilentVibrance.exe\0"
      VALUE "ProductName", "Silent Vibrance\0"
      VALUE "ProductVersion", "2.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
